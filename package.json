    "packages/*"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "zod": "^4.4.3"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
